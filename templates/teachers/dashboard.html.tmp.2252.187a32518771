{% extends 'base.html' %}
{% block title %}Кабинет преподавателя{% endblock %}
{% block content %}
<div class="main-container p-4 mt-2">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-chalkboard-teacher me-2"></i>Результаты экзаменов</h2>
    <a href="{% url 'teacher_logout' %}" class="btn btn-outline-secondary btn-sm">Выйти</a>
  </div>

  <!-- Сортировка -->
  <div class="mb-3">
    <span class="text-muted me-2">Сортировка:</span>
    {% for key, label in sort_options.items %}
      <a href="?sort={{ key }}"
         class="btn btn-sm {% if current_sort == key %}btn-primary{% else %}btn-outline-secondary{% endif %} me-1">
        {{ label }}
      </a>
    {% endfor %}
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="text-center text-muted" style="width:2.5rem">#</th>
          <th style="width:1.5rem"></th>
          <th>Студент</th>
          <th>Экзамен</th>
          <th>Курс</th>
          <th>Дата сдачи</th>
          <th class="text-center">Балл</th>
          <th class="text-center">Лёгкие</th>
          <th class="text-center">Средние</th>
          <th class="text-center">Сложные</th>
          <th class="text-center">На проверке</th>
          <th class="text-center">Действия</th>
        </tr>
      </thead>
      <tbody>
        {% for result in results %}
        <!-- Основная строка -->
        <tr class="result-row" data-bs-toggle="collapse" data-bs-target="#detail-{{ result.id }}"
            style="cursor:pointer;">
          <td class="text-center text-muted small fw-semibold">{{ forloop.counter }}</td>
          <td class="text-muted small">
            <i class="fas fa-chevron-right toggle-icon-{{ result.id }}"></i>
          </td>
          <td>
            <strong>{{ result.student.full_name }}</strong>
            <br><small class="text-muted font-monospace">{{ result.student.student_id }}</small>
          </td>
          <td>{{ result.exam.name }}</td>
          <td>{{ result.exam.course.name }}</td>
          <td class="text-nowrap">{{ result.start_time|date:"d.m.Y H:i" }}</td>

          <!-- Общий балл -->
          <td class="text-center">
            {% if result.max_score and result.max_score > 0 %}
              <span class="badge fs-6
                {% if result.score >= result.max_score %}bg-success
                {% elif result.score >= result.max_score|floatformat:0|add:0 %}bg-warning text-dark
                {% else %}bg-warning text-dark{% endif %}">
                {{ result.score }}/{{ result.max_score }}
              </span>
            {% else %}
              <span class="badge bg-secondary fs-6">{{ result.score }}</span>
            {% endif %}
          </td>

          <!-- Лёгкие -->
          <td class="text-center">
            {% with s=result.difficulty_stats.easy %}
            {% if s %}
              <span class="badge bg-success-subtle text-success border border-success">
                {{ s.correct }}/{{ s.total }}
              </span>
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
            {% endwith %}
          </td>

          <!-- Средние -->
          <td class="text-center">
            {% with s=result.difficulty_stats.medium %}
            {% if s %}
              <span class="badge bg-warning-subtle text-warning border border-warning">
                {{ s.correct }}/{{ s.total }}
              </span>
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
            {% endwith %}
          </td>

          <!-- Сложные -->
          <td class="text-center">
            {% with s=result.difficulty_stats.hard %}
            {% if s %}
              <span class="badge bg-danger-subtle text-danger border border-danger">
                {{ s.correct }}/{{ s.total }}
              </span>
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
            {% endwith %}
          </td>

          <!-- На проверке -->
          <td class="text-center">
            {% if result.pending_count > 0 %}
              <span class="badge bg-warning text-dark">{{ result.pending_count }}</span>
            {% else %}
              <span class="text-success"><i class="fas fa-check"></i></span>
            {% endif %}
          </td>

          <!-- Действия -->
          <td class="text-center text-nowrap" onclick="event.stopPropagation()">
            <a href="{% url 'teacher_result_detail' result.id %}"
               class="btn btn-sm btn-outline-success me-1" title="Полный отчёт">
              <i class="fas fa-file-alt"></i> Отчёт
            </a>
            <a href="{% url 'teacher_review' result.id %}"
               class="btn btn-sm btn-outline-primary" title="Проверить ответы">
              <i class="fas fa-pen"></i> Проверить
            </a>
          </td>
        </tr>

        <!-- Раскрывающаяся строка — детальная статистика по сложности -->
        <tr>
          <td colspan="11" class="p-0 border-0">
            <div class="collapse" id="detail-{{ result.id }}">
              <div class="p-3 bg-light border-start border-4 border-primary">
                <div class="row">
                  <!-- Таблица по сложности -->
                  <div class="col-md-6">
                    <h6 class="text-muted mb-2">
                      <i class="fas fa-layer-group me-1"></i>Разбивка по сложности
                    </h6>
                    <table class="table table-sm table-bordered mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Уровень</th>
                          <th class="text-center">Верных</th>
                          <th class="text-center">Всего</th>
                          <th class="text-center">%</th>
                          <th class="text-center">Баллы</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for key, stat in result.difficulty_stats.items %}
                        <tr>
                          <td>
                            {% if key == 'easy' %}
                              <span class="badge bg-success">{{ stat.label }}</span>
                            {% elif key == 'medium' %}
                              <span class="badge bg-warning text-dark">{{ stat.label }}</span>
                            {% else %}
                              <span class="badge bg-danger">{{ stat.label }}</span>
                            {% endif %}
                          </td>
                          <td class="text-center">{{ stat.correct }}</td>
                          <td class="text-center">{{ stat.total }}</td>
                          <td class="text-center">
                            {% widthratio stat.correct stat.total 100 %}%
                          </td>
                          <td class="text-center"><strong>{{ stat.points }}</strong></td>
                        </tr>
                        {% empty %}
                        <tr>
                          <td colspan="5" class="text-muted text-center">Нет данных</td>
                        </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>

                  <!-- Прогресс-бары -->
                  <div class="col-md-6">
                    <h6 class="text-muted mb-2">
                      <i class="fas fa-chart-bar me-1"></i>Процент верных ответов
                    </h6>
                    {% for key, stat in result.difficulty_stats.items %}
                    <div class="mb-2">
                      <div class="d-flex justify-content-between small mb-1">
                        <span>{{ stat.label }}</span>
                        <span>{{ stat.correct }}/{{ stat.total }}</span>
                      </div>
                      <div class="progress" style="height: 18px;">
                        <div class="progress-bar
                          {% if key == 'easy' %}bg-success
                          {% elif key == 'medium' %}bg-warning
                          {% else %}bg-danger{% endif %}"
                          style="width: {% widthratio stat.correct stat.total 100 %}%">
                          {% widthratio stat.correct stat.total 100 %}%
                        </div>
                      </div>
                    </div>
                    {% endfor %}

                    <div class="mt-3">
                      <a href="{% url 'teacher_result_detail' result.id %}"
                         class="btn btn-success btn-sm w-100">
                        <i class="fas fa-file-alt me-1"></i>Открыть полный отчёт студента
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </td>
        </tr>

        {% empty %}
        <tr>
          <td colspan="11" class="text-center text-muted py-4">Результатов нет</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// Поворот иконки при раскрытии строки
document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(row => {
  const target = row.dataset.bsTarget;
  const id = target.replace('#detail-', '');
  const icon = document.querySelector(`.toggle-icon-${id}`);
  const collapseEl = document.querySelector(target);
  if (!collapseEl || !icon) return;
  collapseEl.addEventListener('show.bs.collapse', () => {
    icon.classList.replace('fa-chevron-right', 'fa-chevron-down');
    row.classList.add('table-active');
  });
  collapseEl.addEventListener('hide.bs.collapse', () => {
    icon.classList.replace('fa-chevron-down', 'fa-chevron-right');
    row.classList.remove('table-active');
  });
});
</script>
{% endblock %}
